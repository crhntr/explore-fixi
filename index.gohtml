<!DOCTYPE html>
<html lang='us-en'>
<head>
	<meta charset="UTF-8">
	<title>Explore Fixi</title>
	<meta name="description" content="Exploring using Fixi with Go">
	<script src="https://cdn.jsdelivr.net/npm/the-fixi-project@0.1.1/dist/the-fixi-project.min.js" integrity="sha256-aQhU79uUGCZTYXEtsijzqKVynikd1uZqOfGAovLVYOU=" crossorigin="anonymous"></script>
	<link href='/static/main.css' rel='stylesheet' type='text/css'>
	<script src='/static/main.js' type='application/javascript' defer></script>
</head>
<body>
	<button fx-action='{{.Path.Increment}}' fx-target='#count' fx-swap='innerHTML'>Increment</button>
	<p id='count' fx-action='{{.Path.Updates}}' fx-trigger='fx:inited' fx-swap='innerHTML'>{{template "count-text" .Result}}</p>
	<p id='tick'></p>
</body>
</html>

{{define "count-text"}}{{.}}{{end}}

{{define "GET /increment Increment()"}}{{template "count-text" .Result}}{{end}}

{{define "GET /{$} Index()"}}{{template "index.gohtml" .}}{{end}}
